.env
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
*.py[cod]

# Personal corpus: intentionally local-only. Never stage this directory.
private/

# The tracked fictional fixture corpus is safe for tests and must ship with the repo.
!tests/fixtures/dev_corpus/private/
!tests/fixtures/dev_corpus/private/**

# Rebuildable market data and local indexes
intel/raw/*
intel/images/*
intel/db/*
intel/posts/*.json
intel/posts/*.npy
intel/posts/*.npz
intel/story-index.json
intel/story-vectors.npy
intel/market-vectors.npy

# Keep the folders in a fresh clone without tracking generated content.
!intel/raw/.gitkeep
!intel/images/.gitkeep
!intel/posts/.gitkeep
!intel/db/.gitkeep

# Cached live intel searches (rebuildable, TTL-bounded)
intel/cache/

# Local derived outputs. They can contain public-profile metadata or personal
# performance data and are rebuilt locally rather than committed.
intel/market-index.json
ops/metrics/*.md
tests/fixtures/dev_corpus/intel/cache/

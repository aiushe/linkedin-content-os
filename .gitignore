.env
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
*.py[cod]

# Personal corpus: intentionally local-only. Never stage this directory.
private/

# The tracked fictional fixture corpus is safe for tests and must ship with the repo.
!tests/fixtures/dev_corpus/private/
!tests/fixtures/dev_corpus/private/**

# Rebuildable market data and local indexes
intel/raw/*
intel/images/*
intel/db/*
intel/posts/*.json
intel/posts/*.npy
intel/posts/*.npz
intel/story-index.json
intel/story-vectors.npy
intel/market-vectors.npy

# Keep the folders in a fresh clone without tracking generated content.
!intel/raw/.gitkeep
!intel/images/.gitkeep
!intel/posts/.gitkeep
!intel/db/.gitkeep

# Cached live intel searches (rebuildable, TTL-bounded)
intel/cache/

# Local derived outputs. They can contain public-profile metadata or personal
# performance data and are rebuilt locally rather than committed.
intel/market-index.json
ops/metrics/*.md
tests/fixtures/dev_corpus/intel/cache/

# Derived third-party post reports remain local-only.
intel/reports/top-posts.md
intel/reports/template-library.md

# Drafts are local review artifacts. Keep the tracked template and empty folders
# so a fresh clone has the required structure, but never track draft contents.
drafts/queue/*
drafts/approved/*
drafts/published/*
drafts/ungated/*
!drafts/queue/.gitkeep
!drafts/approved/.gitkeep
!drafts/published/.gitkeep
!drafts/ungated/.gitkeep

# Week 4 reviewer-only evaluation artifacts. The public repository contains aggregate methods
# and metrics only; datasets, trace evidence, target mappings, and per-case results stay local.
/evals/golden_v2.jsonl
/evals/golden_v2_review.md
/evals/golden_v2_corrections.md
/evals/.jd_mapping.local.md
/evals/results/*
!/evals/results/.gitkeep
/evals/week4_eval.ipynb
/docs/week4_traces/*
!/docs/week4_traces/.gitkeep
/docs/Week4_Private_Appendix.md

# Local editor settings can expose machine-specific paths and integration configuration.
/.claude/settings.local.json

# Human-operated outreach logs accumulate personal names and target-company information.
/ops/outreach-log.md
/ops/engagement-queue.md

# Copy this file to .env. Never commit the resulting file.

# Live model calls (required for the agent to leave offline mode).
# Configure either OpenAI or another OpenAI-compatible provider such as Nebius.
OPENAI_API_KEY=

# Optional: point at any OpenAI-compatible endpoint instead (Nebius, Fireworks, local).
# Example:
#   LLM_BASE_URL=https://api.tokenfactory.nebius.com/v1
#   LLM_API_KEY_ENV=NEBIUS_API_KEY
#   NEBIUS_API_KEY=...
#   MODEL_ROUTER / MODEL_WRITER / MODEL_CRITIC = enabled model IDs
#   MODEL_PRICES_JSON={"some/Model": [0.10, 0.30]}   # keeps the cost table honest
LLM_BASE_URL=
LLM_API_KEY_ENV=OPENAI_API_KEY
NEBIUS_API_KEY=
MODEL_ROUTER=
MODEL_WRITER=
MODEL_CRITIC=
MODEL_PRICES_JSON=
LLM_SEED=
LLM_TIMEOUT_SECONDS=180
LLM_HARD_TIMEOUT_SECONDS=240

# LangSmith dashboard tracing. Enabling it exports prompts and outputs to LangSmith.
LANGSMITH_TRACING=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=

# Market intel. Token from apify.com -> Settings -> Integrations.
APIFY_API_TOKEN=
APIFY_ACTOR_ID=harvestapi/linkedin-profile-posts

# Embeddings. Default provider is openai (reuses OPENAI_API_KEY above).
EMBED_PROVIDER=openai
EMBED_MODEL_OVERRIDE=

# Only needed for --provider voyage, or for image embeddings (Voyage-only).
VOYAGE_API_KEY=

# Optional scraper defaults; configure only after reviewing the actor's pricing and terms.
LINKEDIN_POST_LIMIT=30
LINKEDIN_POSTED_LIMIT=month
ENGAGEMENT_MODE=weighted

# Set to 1 to force deterministic offline mode (tests and the fixture eval suite do this).
AGENT_OFFLINE=
